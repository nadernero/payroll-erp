@echo off
chcp 65001 >nul
title سحب حركات البصمة الشامل (الإدارة والمصنع) والمزامنة السحابية
color 0B
cd /d "%~dp0"
cls
echo ======================================================================
echo    سحب حركات البصمة الشامل (ماكينة الإدارة والمصنع) والمزامنة السحابية
echo ======================================================================
echo.
echo جاري فحص والاتصال بكافة ماكينات البصمة وسحب الحركات ومطابقتها...
echo.
call node scripts/sync-biometric.js
if %errorlevel% neq 0 (
    color 0C
    echo.
    echo [X] واجهت إحدى الماكينات مشكلة في الاتصال.
    echo.
    pause
    exit /b %errorlevel%
)
color 0A
echo.
echo ======================================================================
echo  [OK] اكتملت دورة المزامنة ورفع البصمات إلى السحابة بنجاح!
echo  رابط المتابعة السحابي: https://company-payroll-erp-2026.web.app
echo ======================================================================
echo.
pause
