@echo off
chcp 65001 >nul
title سحب حركات البصمة والمزامنة السحابية
color 0B
cd /d "%~dp0"
cls
echo ======================================================================
echo         سحب حركات البصمة من ماكينة الإدارة والمزامنة السحابية
echo ======================================================================
echo.
echo [1/2] جاري الاتصال بماكينة البصمة (192.168.1.66) وسحب الحركات...
echo.
call node scripts/sync-biometric.js
if %errorlevel% neq 0 (
    color 0C
    echo.
    echo [X] فشلت العملية! يرجى التأكد من اتصال الماكينة بنفس شبكة الراوتر.
    echo.
    pause
    exit /b %errorlevel%
)
color 0A
echo.
echo ======================================================================
echo  [OK] تمت المزامنة ورفع البصمات إلى السحابة بنجاح!
echo  رابط المتابعة السحابي: https://company-payroll-erp-2026.web.app
echo ======================================================================
echo.
pause
