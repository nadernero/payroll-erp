@echo off
chcp 65001 >nul
title تثبيت خدمة المزامنة الآلية لماكينات البصمة (Windows Task Scheduler)
color 0B
cd /d "%~dp0"
cls

echo ======================================================================
echo    تثبيت المزامنة الآلية الصامتة لماكينات البصمة في الخلفية
echo ======================================================================
echo.

set TASK_NAME=PayrollERP_BiometricSync
set VBS_PATH=%~dp0scripts\run-silent.vbs

echo [1/2] جاري إنشاء مهمة ويندوز المجدولة كل 15 دقيقة...
echo.

schtasks /delete /tn "%TASK_NAME%" /f >nul 2>&1

schtasks /create /tn "%TASK_NAME%" /tr "wscript.exe \"%VBS_PATH%\"" /sc minute /mo 15 /f

if %ERRORLEVEL% equ 0 goto SUCCESS
goto FAILED

:SUCCESS
color 0A
echo.
echo ======================================================================
echo  [OK] تم تثبيت المزامنة الآلية بنجاح في نظام ويندوز!
echo ======================================================================
echo.
echo  المميزات المفعلة:
echo  1. المزامنة ستعمل في الخلفية بصمت تام بدون شاشات سوداء أو إزعاج.
echo  2. تفحص وتسحب البصمات آليا كل 15 دقيقة من:
echo     - ماكينة الإدارة الداخلية: 192.168.1.66
echo     - ماكينة المصنع والورشة: 81.10.115.81
echo     - أي ماكينة أخرى تسجلها في النظام مستقبلاً.
echo  3. ترفع البيانات مباشرة لقاعدة بيانات السحابة مركزيا.
echo  4. يتم تسجيل تقرير كل عملية في: logs\biometric-sync.log
echo.
echo [2/2] جاري تشغيل أول دورة مزامنة للتجربة في الخلفية...
schtasks /run /tn "%TASK_NAME%" >nul 2>&1
echo  تم تشغيل أول دورة مزامنة بنجاح.
echo.
echo  الموقع السحابي سيكون محدثا دائما 24/7 دون الحاجة لأي تدخل يدوي:
echo  https://company-payroll-erp-2026.web.app
echo ======================================================================
goto END

:FAILED
color 0C
echo.
echo ======================================================================
echo  [X] تعذر تثبيت المهمة المجدولة.
echo  يرجى الضغط كليك يمين على هذا الملف واختيار:
echo  "Run as administrator / تشغيل كمسؤول"
echo ======================================================================

:END
echo.
pause
