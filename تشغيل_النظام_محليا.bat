@echo off
chcp 65001 > nul
title نظام إدارة المرتبات وشؤون العاملين - التشغيل المحلي
cls
echo ======================================================================
echo           🚀 نظام إدارة المرتبات وشؤون العاملين (Payroll ERP)
echo                    التشغيل المحلي على جهاز الكمبيوتر
echo ======================================================================
echo.

:: 1. التحقق من تثبيت Node.js
where node >nul 2>nul
if %errorlevel% neq 0 (
    echo [X] خطأ: برنامج Node.js غير مثبت على هذا الجهاز!
    echo يرجى تحميل وتثبيت Node.js من الموقع الرسمي: https://nodejs.org
    echo بعد التثبيت، أعد تشغيل هذا الملف.
    echo.
    pause
    exit /b
)

:: 2. التحقق من وجود حزمة المكتبات node_modules
if not exist "node_modules\" (
    echo [*] جاري تثبيت مكتبات النظام لأول مرة (npm install)... يرجى الانتظار...
    call npm install
    echo.
)

:: 3. التحقق من وجود ملفات الواجهة client/dist
if not exist "client\dist\" (
    echo [*] جاري بناء واجهة المستخدم (npm run build)...
    call npm run build
    echo.
)

:: 4. فتح المتصفح وتشغيل الخادم
echo ======================================================================
echo  ✅ جاري فتح المتصفح تلقائياً على الرابط: http://localhost:5000
echo  ✅ الخادم المحلي يعمل الآن بنجاح!
echo  ⚠️  تنبيه: لا تغلق هذه النافذة السوداء طالما أنك تعمل على النظام.
echo ======================================================================
echo.
start http://localhost:5000
node server/index.js
pause
