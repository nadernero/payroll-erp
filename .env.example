# ==============================================================================
# Payroll ERP Environment Configuration
# ==============================================================================

# Server Port
PORT=5000

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Database Configuration
# Get these from your Supabase Project Settings -> Database -> Connection String
# ------------------------------------------------------------------------------
# Connection String (URI - Session Pooler mode port 6543 or Direct port 5432):
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# ------------------------------------------------------------------------------
# Supabase API Credentials (Project Settings -> API)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Node Environment (production / development)
NODE_ENV=production
